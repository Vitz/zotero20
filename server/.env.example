# Skopiuj do server/.env na RPi (nie commituj)

# Port na hoście = port w Cloudflare Tunnel (zotero.keyweb.pl → :8089)
ZOTERO20_HOST_PORT=8089
ZOTERO20_IMAGE_ZOTERO=ghcr.io/TWOJ_OWNER/zotero20-zotero:latest
ZOTERO20_IMAGE_DJANGO=ghcr.io/TWOJ_OWNER/zotero20-django:latest

# 0 = nie uruchamiaj kontenera cloudflared (masz już tunel na hoście)
ZOTERO20_ENABLE_CLOUDFLARED=0

# Tylko jeśli obrazy GHCR są prywatne:
# GHCR_PULL_TOKEN=ghp_...
# GHCR_PULL_USER=twoj-github-user

DJANGO_SECRET_KEY=wygeneruj-losowy-klucz
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=zotero.keyweb.pl,localhost,127.0.0.1

# Wymagany — Connector, Google Docs sidebar i curl muszą wysyłać nagłówek X-API-Key
ZOTERO20_API_KEY=wygeneruj-dlugi-losowy-klucz

# Captcha na logowaniu admin /app — none | simple | recaptcha | hcaptcha
CAPTCHA_TYPE=simple

# reCAPTCHA (gdy CAPTCHA_TYPE=recaptcha)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# hCaptcha (gdy CAPTCHA_TYPE=hcaptcha)
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
