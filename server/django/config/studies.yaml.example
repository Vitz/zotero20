# Mapowanie badań → kolekcje Zotero (Local API).
#
# 1. Skopiuj:  cp config/studies.yaml.example config/studies.yaml
# 2. Utwórz kolekcje w Zotero Desktop.
# 3. Pobierz collection_key (8-znakowy klucz):
#      curl -s http://127.0.0.1:23119/api/users/0/collections
#    Szukaj pola "key" przy nazwie kolekcji.
# 4. Wklej prawdziwy klucz zamiast REPLACE_WITH_ZOTERO_COLLECTION_KEY.
# 5. slug (np. badanie-1) to wartość pola "study" w API i w sidebarze Google Docs.

studies:
  badanie-1:
    label: "Badanie 1"
    collection_key: "REPLACE_WITH_ZOTERO_COLLECTION_KEY"
  badanie-2:
    label: "Badanie 2"
    collection_key: "REPLACE_WITH_ZOTERO_COLLECTION_KEY"
