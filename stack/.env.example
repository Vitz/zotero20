# Skopiuj do .env (nie commituj)

# Port na hoście — musi zgadzać się z Cloudflare Tunnel:
# zotero.keyweb.pl → http://172.16.2.10:8089
ZOTERO20_HOST_PORT=8089

# Obrazy z GHCR (repo Vitz/zotero20 → Actions → publish-images)
ZOTERO20_IMAGE_ZOTERO=ghcr.io/vitz/zotero20-zotero:latest
ZOTERO20_IMAGE_DJANGO=ghcr.io/vitz/zotero20-django:latest

# Tylko przy prywatnych obrazach GHCR:
# GHCR_PULL_TOKEN=ghp_...
# GHCR_PULL_USER=Vitz

DJANGO_SECRET_KEY=wygeneruj-losowy-klucz
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=zotero.keyweb.pl,localhost,127.0.0.1
# Opcjonalnie; domyślnie https://<ALLOWED_HOSTS> (bez localhost)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://zotero.keyweb.pl

ZOTERO20_API_KEY=wygeneruj-dlugi-losowy-klucz

# Gunicorn (Mikrus 1.2GB — 1 worker oszczędza RAM; threads=2 żeby Gemini nie blokował /health)
# Cloudflare Free urywa proxy ~100s — Gemini describe na serwerze ma cap 25s;
# sidebar (2.2.3+) woła Gemini bezpośrednio z Apps Script przy kluczu w Ustawieniach.
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180
ZOTERO_PROXY_TIMEOUT=60
ZOTERO_PROXY_DOCUMENT_TIMEOUT=180

# Zotero Web API (zotero.org) — opcjonalnie; kolekcje i import DOI bez lokalnego Zotero/VNC
# Klucz: https://www.zotero.org/settings/keys (uprawnienia: odczyt/zapis biblioteki)
# W GitHub Actions: secret ZOTERO_API_RW lub ZOTER_API_RW → ZOTERO_WEB_API_KEY
ZOTERO_WEB_API_KEY=
# Opcjonalnie — jeśli puste, Django wywoła GET /keys/{apiKey} i odczyta userID
ZOTERO_WEB_USER_ID=

# Google Gemini — opcjonalny fallback serwerowy (preferowany: klucz w Ustawieniach sidebara)
# Klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcjonalnie; domyślnie gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.0-flash-lite

CAPTCHA_TYPE=simple
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
